/* Application Stylesheet for Wallet Intelligence Tracker */

Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

#top-bar {
    dock: top;
    height: 1;
    layout: horizontal;
    background: $surface;
    color: $text;
    padding: 0 1;
}

#app-title {
    width: auto;
    text-style: bold;
    color: $primary;
}

#status-bar {
    width: 1fr;
    text-align: right;
    color: $text-muted;
}

#main-body {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 17;
    min-width: 15;
    max-width: 20;
    height: 100%;
    background: $surface-darken-1;
    border-right: vkey $panel;
    padding: 0;
}

Screen.narrow #sidebar {
    width: 7;
    min-width: 6;
    max-width: 8;
}

Screen.narrow #sidebar-header {
    display: none;
}

#sidebar-header {
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $text-muted;
    background: $surface;
}

#sidebar_list {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#sidebar_list > ListItem {
    padding: 0 1;
    height: 1;
    color: $text;
}

#sidebar_list > ListItem.--highlight {
    background: $accent;
    color: $text;
    text-style: bold;
}

#content-area {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

#bottom-bar {
    dock: bottom;
    height: 1;
    background: $surface-darken-1;
    color: $text-muted;
    padding: 0 1;
    text-wrap: nowrap;
    overflow: hidden;
}

.screen-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.screen-desc {
    color: $text;
    margin-bottom: 1;
    text-wrap: wrap;
    width: 100%;
    height: auto;
}

.screen-stage {
    color: $text-muted;
    text-style: italic;
    margin-bottom: 1;
    text-wrap: wrap;
    width: 100%;
    height: auto;
}

.section-box {
    margin-top: 1;
    padding: 1;
    border: round $primary;
    background: $surface;
    height: auto;
}

.section-subtitle {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.counter-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 2;
    height: auto;
}

.counter-card {
    border: round $panel;
    background: $surface-lighten-1;
    padding: 0 1;
    height: 3;
    content-align: center middle;
    text-style: bold;
    color: $text;
}

/* Wallets Screen Layout */
#wallets-container {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

Screen.narrow #wallets-container {
    layout: vertical;
    height: auto;
}

#group-tree {
    width: 22;
    min-width: 16;
    height: 100%;
    border: solid $panel;
    margin-right: 1;
}

Screen.narrow #group-tree {
    width: 100%;
    height: 8;
    margin-right: 0;
    margin-bottom: 1;
}

#wallet-right-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#wallet-search {
    margin-bottom: 1;
    height: auto;
}

#wallet-table {
    height: 1fr;
    min-height: 6;
    border: solid $panel;
}

#wallet-details {
    height: auto;
    max-height: 10;
    border: solid $accent;
    margin-top: 1;
    padding: 0 1;
    overflow-y: auto;
    text-wrap: wrap;
}

#empty-state {
    padding: 1;
    border: dashed $primary;
    text-align: center;
    color: $text;
    margin-bottom: 1;
}

/* Import Screen Layout */
#import-container {
    layout: vertical;
    height: 1fr;
    width: 100%;
}

#import-file-bar {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

#file-path {
    width: 1fr;
    margin-right: 1;
}

#import-options-bar {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

Screen.narrow #import-options-bar {
    layout: vertical;
}

#format-select {
    width: 22;
    margin-right: 1;
}

#default-group {
    width: 24;
    margin-right: 1;
}

#mode-select {
    width: 22;
    margin-right: 1;
}

#import-buttons-bar {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

#preview-btn {
    margin-right: 1;
}

#import-text {
    height: 8;
    margin-bottom: 1;
}

#preview-table {
    height: 1fr;
    min-height: 6;
    border: solid $panel;
}

#counts-line {
    text-style: bold;
    color: $accent;
    margin: 1 0;
}

#report-line {
    text-style: bold;
    color: $success;
    margin: 1 0;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.6);
}

.modal-dialog {
    width: 70;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}

.modal-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    height: 3;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
}

.form-label {
    margin-top: 1;
    text-style: bold;
    color: $text-muted;
}

.field-error {
    color: $error;
    text-style: bold;
    margin-bottom: 1;
}
