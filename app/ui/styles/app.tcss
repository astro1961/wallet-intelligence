/* Application Stylesheet for Wallet Intelligence Tracker */

Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

#top-bar {
    dock: top;
    height: 1;
    layout: horizontal;
    background: $surface;
    color: $text;
    padding: 0 1;
}

#app-title {
    width: auto;
    text-style: bold;
    color: $primary;
}

#status-bar {
    width: 1fr;
    text-align: right;
    color: $text-muted;
}

#main-body {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 17;
    min-width: 15;
    max-width: 20;
    height: 100%;
    background: $surface-darken-1;
    border-right: vkey $panel;
    padding: 0;
}

#sidebar-header {
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $text-muted;
    background: $surface;
}

#sidebar_list {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#sidebar_list > ListItem {
    padding: 0 1;
    height: 1;
    color: $text;
}

#sidebar_list > ListItem.--highlight {
    background: $accent;
    color: $text;
    text-style: bold;
}

#content-area {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

#bottom-bar {
    dock: bottom;
    height: 1;
    background: $surface-darken-1;
    color: $text-muted;
    padding: 0 1;
    text-wrap: nowrap;
    overflow: hidden;
}

.screen-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.screen-desc {
    color: $text;
    margin-bottom: 1;
}

.screen-stage {
    color: $text-muted;
    text-style: italic;
    margin-bottom: 1;
}

.section-box {
    margin-top: 1;
    padding: 1;
    border: round $primary;
    background: $surface;
    height: auto;
}

.section-subtitle {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.counter-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 2;
    height: auto;
}

.counter-card {
    border: round $panel;
    background: $surface-lighten-1;
    padding: 0 1;
    height: 3;
    content-align: center middle;
    text-style: bold;
    color: $text;
}
